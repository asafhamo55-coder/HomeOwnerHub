{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "SUPABASE_*",
        "POSTGRES_*",
        "AI_*",
        "STRIPE_*",
        "INNGEST_*",
        "PLAID_*",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "TWILIO_*",
        "HUGGINGFACE_API_TOKEN",
        "EMBEDDING_BASE_URL",
        "EMBEDDING_MODEL",
        "MARKET_DATA_*",
        "SCREENER_APP_URL",
        "CRON_SECRET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
