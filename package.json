{
  "name": "homeowner-portal",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "build:email-assets": "tsx scripts/build-email-assets.ts",
    "brand:assets": "tsx scripts/build-brand-assets.ts",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:integration": "tsc --noEmit -p tsconfig.integration.json",
    "typecheck:scripts": "tsc --noEmit -p scripts/release-notes/tsconfig.json && tsc --noEmit -p scripts/owner-actions/tsconfig.json && tsc --noEmit -p scripts/backlog-email/tsconfig.json && tsc --noEmit -p scripts/guide/tsconfig.json",
    "release-notes:preview": "tsx scripts/release-notes/send.ts --dry-run",
    "dev:hoa": "turbo run dev --filter=hoa",
    "dev:eviction": "turbo run dev --filter=eviction",
    "dev:pm": "turbo run dev --filter=pm",
    "dev:marketing": "turbo run dev --filter=marketing",
    "seed:sample-ccr": "tsx scripts/seed-sample-ccr.ts",
    "seed:accounting": "tsx scripts/seed-accounting.ts",
    "seed:comm-templates": "tsx scripts/seed-comm-templates.ts",
    "generate:community-sql": "tsx --tsconfig apps/hoa/tsconfig.json scripts/generate-community-templates-sql.ts",
    "seed:demo-comms": "tsx scripts/seed-demo-comms.ts",
    "test:accounting": "tsx scripts/test-accounting.ts",
    "test:ar": "tsx scripts/test-ar.ts",
    "test:bank-rec": "tsx scripts/test-bank-rec.ts",
    "test:ap": "tsx scripts/test-ap.ts",
    "test:reports-close": "tsx scripts/test-reports-close.ts",
    "test:rfp-bid-submit": "tsx scripts/test-rfp-bid-submit.ts",
    "test:vendor-onboard-submit": "tsx scripts/test-vendor-onboard-submit.ts",
    "test:bids": "tsx scripts/test-bids.ts",
    "test:chunker": "tsx scripts/test-chunker.ts",
    "test:late-fees": "tsx scripts/test-late-fees.ts",
    "test:recurring-jes": "tsx scripts/test-recurring-jes.ts",
    "test:documents": "tsx scripts/test-documents.ts",
    "test:je-actions": "tsx scripts/test-je-actions.ts",
    "test:comms": "tsx scripts/test-comms.ts",
    "test:community-templates": "tsx --tsconfig apps/hoa/tsconfig.json scripts/test-community-templates.ts",
    "test:property-resolve": "tsx scripts/test-property-resolve.ts",
    "test:inbox-rls": "tsx scripts/test-inbox-rls.ts",
    "test:inbox-drafts": "tsx scripts/test-inbox-drafts.ts",
    "test:inbox-match": "tsx scripts/test-inbox-match.ts",
    "test:mailbox-sync": "tsx scripts/test-mailbox-sync.ts",
    "smoke:pdf": "tsx scripts/smoke-pdf.ts",
    "backfill:embeddings": "tsx scripts/backfill-embeddings.ts",
    "eval:w1": "tsx scripts/eval-w1.ts",
    "ingest:state-law": "tsx scripts/ingest-state-statutes.ts",
    "scrape:state-law": "tsx scripts/scrape-state-law.ts",
    "migrate:properties-residents": "tsx scripts/migrate-properties-residents.ts",
    "db:local:reset": "tsx scripts/local-db-reset.ts",
    "ui:shots": "tsx scripts/ui-shots.ts",
    "ui:overflow": "tsx scripts/ui-shots.ts --overflow",
    "guide:build": "tsx scripts/guide-build.ts",
    "guide:check": "tsx scripts/guide-check.ts",
    "guide:eval": "tsx --tsconfig apps/hoa/tsconfig.json scripts/guide-eval.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:stripe-sandbox": "vitest run --config tests/stripe-sandbox/vitest.config.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "@types/node": "^22",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "marked": "^18.1.1",
    "playwright": "^1.46.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sharp": "0.34.5",
    "stripe": "^17.0.0",
    "tsx": "^4.19.0",
    "turbo": "latest",
    "typescript": "^5",
    "vitest": "^2.1.9",
    "yaml": "^2.8.4",
    "zod": "^3.25.76"
  }
}
