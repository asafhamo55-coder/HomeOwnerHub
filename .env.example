# Stable public origin for email images. Must be the production domain over
# https — never a preview host, never localhost. Email is immutable once
# delivered, so a wrong value here breaks images permanently.
EMAIL_ASSET_BASE_URL=https://www.homeownerledger.com

# HMAC key for the 24-hour session cap (apps/hoa). Optional: when unset, the
# cap falls back to SUPABASE_SERVICE_ROLE_KEY, which is already present in
# every hoa deploy. Set a dedicated value if you'd rather the session stamp
# not share a key with the service role. Rotating this key invalidates every
# outstanding stamp, so all signed-in users get one fresh 24h window.
# If NEITHER is set, sessions are not capped and middleware logs an error.
SESSION_CAP_SECRET=
