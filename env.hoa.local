# ── Stripe ───────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# After creating products in Stripe, paste the price IDs here:
STRIPE_PRICE_STARTER=price_REPLACE_ME    # $39/mo — HOA ≤50 doors
STRIPE_PRICE_STANDARD=price_REPLACE_ME  # $79/mo — HOA 51-300 doors
STRIPE_PRICE_PRO=price_REPLACE_ME       # $149/mo — HOA 301-600 doors

# ── AI (RunPod vLLM) ──────────────────────────────────────────
# Primary: RunPod A10G running Qwen 2.5 14B via vLLM
AI_BASE_URL=https://REPLACE_WITH_RUNPOD_ENDPOINT/v1
AI_BASE_URL_FAST=https://REPLACE_WITH_RUNPOD_FAST_ENDPOINT/v1
AI_BASE_URL_VISION=https://REPLACE_WITH_RUNPOD_VISION_ENDPOINT/v1
AI_API_KEY=REPLACE_WITH_RUNPOD_API_KEY
AI_MODEL=Qwen/Qwen2.5-14B-Instruct
AI_MODEL_FAST=Qwen/Qwen2.5-3B-Instruct
AI_MODEL_VISION=Qwen/Qwen2-VL-7B-Instruct

# Fallback: always-warm CPU server (Ollama or llama.cpp)
AI_FALLBACK_URL=http://localhost:11434/v1

# Cloud fallback: Claude Haiku (for daily digest, short summaries)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ── Inngest ───────────────────────────────────────────────────
# Get from: https://app.inngest.com/
INNGEST_EVENT_KEY=REPLACE_ME
INNGEST_SIGNING_KEY=REPLACE_ME

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HOA Hub
NEXT_PUBLIC_HUB_TYPE=hoa
