# ── Error tracking (Sentry) — optional ───────────────────────────────
# All unset = Sentry fully inert: nothing captured, nothing uploaded.
# See docs/OBSERVABILITY.md. One Sentry project per app; the DSN is not a
# secret (it ships to the browser), the auth token is.
# SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project>
# Build-time only, for source-map upload. Leave unset locally.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ── Origins — optional ───────────────────────────────────────────────
# This site's own origin, for canonical URLs, the sitemap, robots.txt and
# OG URLs (lib/site.ts). Unset = https://www.homeownerledger.online. Only
# www.homeownerledger.online, *.vercel.app or localhost are accepted; any
# other value falls back to the default. Only the default is indexable.
# NEXT_PUBLIC_SITE_URL=https://www.homeownerledger.online
# The HOA app: Sign in / Create account links and app-path redirects
# (lib/app-origin.ts). Unset = https://www.homeownerledger.com.
# NEXT_PUBLIC_APP_URL=https://www.homeownerledger.com

# ── Search Console — optional ────────────────────────────────────────
# The "content" value of Google Search Console's HTML-tag verification
# (OA-35). Unset = no verification tag is rendered.
# NEXT_PUBLIC_GSC_VERIFICATION=

# ── Support chat — optional (the "Questions? Ask us" button) ─────────
# Off unless NEXT_PUBLIC_SUPPORT_CHAT=1 (build-time, so redeploy after changing).
# NEXT_PUBLIC_SUPPORT_CHAT=1
# Same provider setup as apps/hoa. Without AI_API_KEY the chat shows a
# "not available yet" note and /api/chat answers 503.
# AI_API_KEY=
# AI_MODEL=              # optional; default is the tested fast model in packages/ai
# AI_BASE_URL=           # optional; default https://api.groq.com/openai/v1
# CHAT_DAILY_CAP=400     # global requests per day per server instance
# "Talk to a person" is delivered with the /demo form's RESEND_API_KEY to
# support@homeownerledger.com (override with SUPPORT_INBOX_EMAIL).
