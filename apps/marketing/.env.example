# ── Error tracking (Sentry) — optional ───────────────────────────────
# All unset = Sentry fully inert: nothing captured, nothing uploaded.
# See docs/OBSERVABILITY.md. One Sentry project per app; the DSN is not a
# secret (it ships to the browser), the auth token is.
# SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project>
# Build-time only, for source-map upload. Leave unset locally.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ── Origins — optional ───────────────────────────────────────────────
# This site's own origin, for canonical and OG URLs (lib/site.ts).
# Unset = https://www.homeownerledger.com. Only www/apex, *.vercel.app or
# localhost are accepted.
# NEXT_PUBLIC_SITE_URL=https://www.homeownerledger.com
# The HOA app (lib/app-origin.ts). Unset = https://app.homeownerledger.com.
# NEXT_PUBLIC_APP_URL=https://app.homeownerledger.com
