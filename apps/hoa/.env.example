# Copy to .env.local and fill in REPLACE_ME values.
# .env.local is gitignored; .env.example is committed.

# ── Supabase (public — RLS enforces auth) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xwdjsxfskvreguyvryhc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh3ZGpzeGZza3ZyZWd1eXZyeWhjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgxMTEwNjAsImV4cCI6MjA5MzY4NzA2MH0.4xSNopnsyFxN0OO7qq7LICin3QIH2VFxcqpSLgxTjps

# ── Supabase service role (server-only, bypasses RLS) ────────────────
# Get from: https://supabase.com/dashboard/project/xwdjsxfskvreguyvryhc/settings/api
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# ── AI: RunPod vLLM endpoints (Qwen 2.5 14B + 3B) ────────────────────
AI_BASE_URL=REPLACE_ME
AI_BASE_URL_FAST=REPLACE_ME
AI_BASE_URL_VISION=REPLACE_ME
AI_API_KEY=REPLACE_ME
AI_MODEL=Qwen/Qwen2.5-14B-Instruct
AI_MODEL_FAST=Qwen/Qwen2.5-3B-Instruct
AI_MODEL_VISION=Qwen/Qwen2-VL-7B-Instruct

# ── AI: CPU fallback (Ollama / llama.cpp on always-warm VM) ──────────
AI_FALLBACK_URL=REPLACE_ME
AI_FALLBACK_MODEL=qwen2.5:7b

# ── AI: "Cloud" agent (Daily Digest summarization) ───────────────────
# Now points at the same RunPod Qwen 14B endpoint as the main agent.
# 100% open source. Override AI_MODEL_CLOUD if you want a different
# model for digests specifically.
AI_MODEL_CLOUD=Qwen/Qwen2.5-14B-Instruct

# ── Stripe (test mode for now) ───────────────────────────────────────
STRIPE_SECRET_KEY=REPLACE_ME
STRIPE_WEBHOOK_SECRET=REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_ME
STRIPE_PRICE_STARTER=REPLACE_ME
STRIPE_PRICE_STANDARD=REPLACE_ME
STRIPE_PRICE_PRO=REPLACE_ME

# ── Inngest (scheduled jobs) ─────────────────────────────────────────
# Local dev: run `npx inngest-cli@latest dev` in another terminal.
#   The dev server at http://localhost:8288 auto-discovers the handler
#   at http://localhost:3000/api/inngest, so these are optional locally.
# Production: get keys from https://app.inngest.com/env/production/manage
INNGEST_EVENT_KEY=REPLACE_ME
INNGEST_SIGNING_KEY=REPLACE_ME

# ── Cross-hub linking ────────────────────────────────────────────────
NEXT_PUBLIC_EVICTION_URL=http://localhost:3001
NEXT_PUBLIC_PM_URL=http://localhost:3002

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Dev auto-login (LOCAL ONLY — do NOT set in prod) ─────────────────
# Set DEV_AUTOLOGIN=1 to skip the /login screen. Middleware will bounce
# unauth requests through /auth/dev-login, which signs in the user
# below via service-role and continues to the original destination.
# The email must already exist in auth.users.
# DEV_AUTOLOGIN=1
# DEV_AUTOLOGIN_EMAIL=you@example.com

# ── State-law scraper (LOCAL ONLY, used by pnpm scrape:state-law) ────
# Sign up at https://www.browserless.io/ for a free token. Browserless
# runs Chromium server-side with residential IPs that Cloudflare
# doesn't block (Justia 403s our local Chromium even with stealth).
# Leave unset to fall back to local Chromium — works for non-protected
# sites but won't get past Justia.
# BROWSERLESS_TOKEN=YOUR_BROWSERLESS_TOKEN
# BROWSERLESS_ENDPOINT=wss://production-sfo.browserless.io  # optional
